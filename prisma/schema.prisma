generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EVALUATOR
}

model User {
  id          String   @id @default(cuid())
  fullName    String
  username    String   @unique
  password    String   // ذخیره رمز عبور (یا هش)
  phone       String?
  shebaNumber String?  // شماره شبا ارزیاب جهت تسویه مالی
  role        UserRole @default(EVALUATOR)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdSchools     School[]            @relation("EvaluatorSchools")
  assignedSchools    School[]            @relation("AssignedSchools")
  teacherEvaluations TeacherEvaluation[] @relation("EvaluatorEvaluations")
  assistants         AssistantEvaluator[] @relation("EvaluatorAssistants")
  timesheets         TimesheetLog[]      @relation("EvaluatorTimesheets")

  @@map("users")
}

model AssistantEvaluator {
  id           String   @id @default(cuid())
  fullName     String
  phone        String?
  nationalCode String?
  shebaNumber  String?  // شماره شبا کمک‌ارزیاب جهت تسویه مالی
  notes        String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ارزیاب ارشد متصل
  evaluatorId  String
  evaluator    User     @relation("EvaluatorAssistants", fields: [evaluatorId], references: [id], onDelete: Cascade)

  timesheets   TimesheetLog[]

  @@map("assistant_evaluators")
}

enum WorkerType {
  EVALUATOR           // ارزیاب اصلی
  ASSISTANT_EVALUATOR // کمک ارزیاب
}

enum TimesheetStatus {
  PENDING   // در انتظار بررسی و تایید مدیر
  APPROVED  // تایید شده
  REVISED   // تعدیل شده توسط مدیر (کمتر یا بیشتر)
  REJECTED  // رد شده
}

model TimesheetLog {
  id                   String              @id @default(cuid())
  date                 DateTime            @default(now())
  durationMinutes      Int                 // مدت زمان کارکرد ثبت‌شده بر حسب دقیقه
  approvedMinutes      Int?                // مدت زمان کارکرد تایید شده توسط مدیر بر حسب دقیقه (در صورت تایید)
  status               TimesheetStatus     @default(PENDING)
  adminNotes           String?             @db.Text // یادداشت یا علت تعدیل ساعت توسط مدیر
  workerType           WorkerType          @default(EVALUATOR)
  description          String?             @db.Text // شرح کارکرد و فعالیت

  // ارزیاب ثبت‌کننده
  evaluatorId          String
  evaluator            User                @relation("EvaluatorTimesheets", fields: [evaluatorId], references: [id], onDelete: Cascade)

  // اگر کارکرد برای کمک ارزیاب باشد
  assistantEvaluatorId String?
  assistantEvaluator   AssistantEvaluator? @relation(fields: [assistantEvaluatorId], references: [id], onDelete: SetNull)

  // ارتباط اختیاری با مدرسه
  schoolId             String?
  school               School?             @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@map("timesheet_logs")
}

enum SchoolOwnership {
  GOVERNMENTAL        // دولتی
  NON_GOVERNMENTAL    // غیردولتی
  BOARD_OF_TRUSTEES   // هیئت‌امنایی
  NEMOONE_DOLATI      // نمونه دولتی
  SAMPAD              // استعدادهای درخشان
  SHAHED              // شاهد
  ORGANIZATION_TIED   // وابسته به نهاد یا سازمان خاص
  VOCATIONAL          // هنرستان
  HYBRID_SPECIAL      // مدرسه خاص یا ترکیبی
  OTHER               // سایر
}

enum AdmissionType {
  PUBLIC              // ثبت‌نام عمومی
  EXAM_BASED          // پذیرش بر اساس آزمون
  INTERVIEW_RESUME    // پذیرش بر اساس مصاحبه یا بررسی سوابق
  REGIONAL            // پذیرش منطقه‌ای
  SELECTIVE_LIMITED   // پذیرش محدود یا گزینشی
  HYBRID              // ترکیبی
}

enum SchoolDominantApproach {
  EDUCATIONAL_GRADE_ORIENTED // آموزشی و نمره‌محور
  EDUCATIONAL_CULTURAL       // تربیتی و فرهنگی
  SKILL_ORIENTED             // مهارت‌محور
  RESEARCH_ORIENTED          // پژوهش‌محور
  PROBLEM_ORIENTED           // مسئله‌محور
  RELIGIOUS_VALUE            // دینی و ارزشی
  ARTISTIC_CREATIVE          // هنری و خلاق
  ENTREPRENEURSHIP           // کارآفرینی
  HYBRID                     // ترکیبی
}

enum HumanitiesAttitude {
  POSITIVE_SERIOUS    // مثبت و جدی
  POSITIVE_LOW_INFO   // مثبت اما کم‌اطلاع
  NEUTRAL             // خنثی
  WEAK_STEREOTYPICAL  // ضعیف یا کلیشه‌ای
}

model School {
  id              String                 @id @default(cuid())
  name            String
  code            String?                @unique // کد مدرسه
  province        String                 @default("تهران") // استان
  city            String                 @default("تهران") // شهرستان
  district        String                 // منطقه آموزش و پرورش
  address         String?
  ownershipType   SchoolOwnership        @default(GOVERNMENTAL)
  ownershipOther  String?
  admissionType   AdmissionType          @default(PUBLIC)

  // رویکرد تربیتی و فرهنگی مدرسه
  dominantApproach SchoolDominantApproach @default(EDUCATIONAL_CULTURAL)
  approachEvidence String?                @db.Text // شواهد عملی رویکرد

  // ظرفیت در حوزه علوم انسانی
  humanitiesAttitude HumanitiesAttitude?
  
  // سوابق مدرسه در زمینه‌های ۱۰‌گانه (آرایه متنی)
  humanitiesActivities String[]          @default([])

  // زمینه‌های ظرفیت دانش‌آموزان
  studentCapacities    String[]          @default([])

  // میزان آمادگی مدرسه برای اجرای برنامه‌های علوم انسانی
  humanitiesReadinessLevel String?       @db.Text

  // اطلاعات اداری و تماس (ثبت پایه توسط مدیر)
  principalName   String?                // نام مدیر مدرسه
  phone           String?                // تلفن مدرسه
  notes           String?                @db.Text // یادداشت‌های اولیه مدیر

  // ارزیاب ثبت‌کننده مدرسه
  createdById         String?
  createdBy           User?                  @relation("EvaluatorSchools", fields: [createdById], references: [id], onDelete: SetNull)

  // ارزیاب تخصیص‌یافته توسط مدیر
  assignedEvaluatorId String?
  assignedEvaluator   User?                  @relation("AssignedSchools", fields: [assignedEvaluatorId], references: [id], onDelete: SetNull)

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  teachers        Teacher[]
  timesheets      TimesheetLog[]

  @@map("schools")
}

enum CollaborationStatus {
  KEY_AXIS               // محور (بالای ۸۰ درصد نمره کل)
  DEVELOPMENTAL_RELATION // مستعد ارتباط رشدی (بین ۵۰ تا ۸۰ درصد نمره کل)
  OCCASIONAL_RELATION    // ارتباط موردی (بین ۳۰ تا ۵۰ درصد نمره کل)
  UNSUITABLE             // نامناسب همکاری (زیر ۳۰ درصد نمره کل)
  PENDING_EVALUATION     // در انتظار ارزیابی
}

model Teacher {
  id                  String              @id @default(cuid())
  firstName           String
  lastName            String
  phone               String?             @unique
  nationalCode        String?             @unique
  teachingYears       Int                 @default(0) // سابقه کار / تدریس
  roleTitle           String              @default("معلم") // نقش فرد در مدرسه (معلم، مشاور، معاون آموزشی، معاون پرورشی، معاون اجرایی، مدیر، مربی تربیتی/بهداشت، سایر)
  subject             String              // رشته تدریس یا حوزه فعالیت
  grade               String              // مقطع تدریس / فعالیت
  schoolId            String?
  school              School?             @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolNameManual    String?             // در صورتی که نام مدرسه دستی وارد شود
  schoolTypeManual    String?             // نوع مدرسه دستی
  collaborationStatus CollaborationStatus @default(PENDING_EVALUATION)
  bio                 String?             @db.Text

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  evaluations         TeacherEvaluation[]

  @@map("teachers")
}

enum FamiliarityLevel {
  LOW      // کم
  MEDIUM   // متوسط
  HIGH     // زیاد
}

model TeacherEvaluation {
  id                  String              @id @default(cuid())
  teacherId           String
  teacher             Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  evaluatorId         String
  evaluator           User                @relation("EvaluatorEvaluations", fields: [evaluatorId], references: [id], onDelete: Restrict)

  evaluationDate      DateTime            @default(now())
  dialogueDurationMin Int                 @default(30) // مدت گفت‌وگو
  familiarityLevel    FamiliarityLevel    @default(MEDIUM) // سطح آشنایی ارزیاب با معلم

  // --- محور ۱: رابطه تربیتی و اثرگذاری بر دانش‌آموز (وزن ۱۵٪ - سقف ۵۰ نمره خام) ---
  scoreAxis1_1        Int                 @default(0) // شناخت دانش‌آموزان فراتر از نمره و عملکرد درسی (۰ تا ۳۰)
  scoreAxis1_2        Int                 @default(0) // وجود رابطه اعتمادآمیز و رجوع واقعی (۰ تا ۲۰)
  rawAxis1            Int                 @default(0) // جمع خام (۰ تا ۵۰)
  qualitativeAxis1    String?             // برچسب کیفی ۴‌گانه محور ۱
  notesAxis1          String?             @db.Text    // نظر ارزیاب

  // --- محور ۲: توان شناسایی استعداد (وزن ۲۵٪ - سقف ۸۰ نمره خام) ---
  scoreAxis2_1        Int                 @default(0) // تشخیص ظرفیت دانش‌آموز فراتر از معدل و رتبه (۰ تا ۳۰)
  scoreAxis2_2        Int                 @default(0) // ارائه شواهد عینی از رفتار و عملکرد متفاوت (۰ تا ۳۰)
  scoreAxis2_3        Int                 @default(0) // توان تشخیص ظرفیت‌های علوم انسانی (۰ تا ۲۰)
  rawAxis2            Int                 @default(0) // جمع خام (۰ تا ۸۰)
  qualitativeAxis2    String?             // برچسب کیفی ۴‌گانه محور ۲

  // --- محور ۳: نگرش و ظرفیت علوم انسانی (وزن ۱۵٪ - سقف ۱۰۰ نمره خام) ---
  scoreAxis3_1        Int                 @default(0) // باور به اهمیت علوم انسانی و پرهیز از نگاه کلیشه‌ای (۰ تا ۳۵)
  scoreAxis3_2        Int                 @default(0) // شناخت اولیه و واقع‌بینانه از حوزه‌های علوم انسانی (۰ تا ۳۵)
  scoreAxis3_3        Int                 @default(0) // توان پیوند علوم انسانی با مسائل واقعی (۰ تا ۳۰)
  rawAxis3            Int                 @default(0) // جمع خام (۰ تا ۱۰۰)
  qualitativeAxis3    String?             // برچسب کیفی ۴‌گانه محور ۳

  // --- محور ۴: سرمایه ارتباطی و ظرفیت شبکه‌سازی (وزن ۲۵٪ - سقف ۱۰۰ نمره خام) ---
  scoreAxis4_1        Int                 @default(0) // دسترسی مؤثر به دانش‌آموزان و مدارس (۰ تا ۳۵)
  scoreAxis4_2        Int                 @default(0) // ارتباط حرفه‌ای با معلمان، مدیران و مشاوران (۰ تا ۳۵)
  scoreAxis4_3        Int                 @default(0) // توان معرفی و همراه‌کردن افراد با برنامه مشترک (۰ تا ۳۰)
  rawAxis4            Int                 @default(0) // جمع خام (۰ تا ۱۰۰)
  qualitativeAxis4    String?             // برچسب کیفی ۴‌گانه محور ۴

  // --- محور ۵: تعهد و قابلیت همکاری اجرایی (وزن ۲۰٪ - سقف ۷۵ نمره خام) ---
  scoreAxis5_1        Int                 @default(0) // سابقه اجرای فعالیت تربیتی/آموزشی از آغاز تا پایان (۰ تا ۳۰)
  scoreAxis5_2        Int                 @default(0) // داشتن زمان و امکان برای همکاری منظم (۰ تا ۲۰)
  scoreAxis5_3        Int                 @default(0) // توان همکاری تیمی، چارچوب‌پذیری و بازخورد (۰ تا ۲۵)
  rawAxis5            Int                 @default(0) // جمع خام (۰ تا ۷۵)
  qualitativeAxis5    String?             // برچسب کیفی ۴‌گانه محور ۵

  // نمره کل موزون و جمع‌بندی نهایی
  totalWeightedScore  Float               @default(0)
  finalRecommendation CollaborationStatus @default(PENDING_EVALUATION)
  finalNotes          String?             @db.Text

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("teacher_evaluations")
}
